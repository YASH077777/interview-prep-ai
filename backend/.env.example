# Copy this file to ".env" (same folder) and fill in the values
PORT=5000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/interview-prep for local MongoDB)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interview-prep?retryWrites=true&w=majority
# Any long random string
JWT_SECRET=change_me_to_a_long_random_string
# Free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# Only needed after you deploy the frontend (adds it to CORS)
# FRONTEND_URL=https://your-frontend.vercel.app
